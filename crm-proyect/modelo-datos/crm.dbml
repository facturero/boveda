  auth.users
  auth.credentials
  auth.oauth_accounts
  auth.refresh_tokens
  auth.password_reset_tokens
  auth.organizations
  auth.organization_memberships
  auth.permissions
  auth.roles
  auth.role_permissions
  auth.user_roles
  auth.user_establishments
  auth.pos_devices
  auth.device_refresh_tokens
  auth.trusted_ips
  auth.outbox_messages
  auth.processed_events
}

TableGroup organization_db {
  organization.organizations
  organization.establishments
  organization.emission_points
  organization.pos_themes
  organization.organization_countries
  organization.countries
  organization.outbox_messages
}

TableGroup tax_db {
  tax.countries
  tax.tax_rates
  tax.identification_types
  tax.document_types
  tax.outbox_messages
}

TableGroup customer_db {
  customer.customers
  customer.contacts
  customer.addresses
  customer.tags
  customer.customer_tags
  customer.identification_types
  customer.outbox_messages
  customer.processed_events
}

TableGroup product_db {
  product.categories
  product.units
  product.products
  product.product_taxes
  product.product_images
  product.product_establishments
  product.outbox_messages
}

TableGroup inventory_db {
  inventory.warehouses
  inventory.stock_positions
  inventory.stock_movements
  inventory.stock_layers
  inventory.reservations
  inventory.products
  inventory.organization_plugins
  inventory.inventory_gaps
  inventory.outbox_messages
  inventory.processed_events
}

TableGroup billing_db {
  billing.invoices
  billing.invoice_lines
  billing.line_taxes
  billing.invoice_tax_totals
  billing.sequences
  billing.outbox_messages
  billing.processed_events
}

TableGroup fiscal_db {
  fiscal.fiscal_invoices
  fiscal.certificates
  fiscal.outbox_messages
  fiscal.processed_events
}

TableGroup document_db {
  document.file_references
  document.outbox_messages
}

TableGroup plugin_catalog_db {
  plugin_catalog.plugins
  plugin_catalog.plugin_translations
  plugin_catalog.plugin_dependencies
  plugin_catalog.organization_plugins
  plugin_catalog.plugin_custom_requests
  plugin_catalog.business_profiles
  plugin_catalog.business_profile_plugins
  plugin_catalog.business_profile_translations
  plugin_catalog.organization_business_profiles
  plugin_catalog.outbox_messages
}

TableGroup notification_db {
  notification.notifications
  notification.notification_preferences
  notification.processed_events
}

TableGroup audit_db {
  audit.audit_logs
  audit.processed_events
}

TableGroup assistant_db {
  assistant.conversations
  assistant.messages
  assistant.pending_actions
  assistant.usage_counters
  assistant.outbox_messages
}

// ===========================================================================
//  RELACIONES DENTRO DEL SERVICIO
//  Las marcadas «FK» existen como FOREIGN KEY en MySQL; las demás existen en los
//  modelos pero la base no las exige («sin FK en BD»).
// ===========================================================================

// --- auth ---
Ref: auth.credentials.user_id - auth.users.id                              // FK (RESTRICT)
Ref: auth.oauth_accounts.credential_id > auth.credentials.id               // FK (CASCADE)
Ref: auth.refresh_tokens.credential_id > auth.credentials.id               // FK (CASCADE)
Ref: auth.password_reset_tokens.user_id > auth.users.id                    // sin FK en BD
Ref: auth.organization_memberships.user_id > auth.users.id                 // FK (CASCADE)
Ref: auth.organization_memberships.organization_id > auth.organizations.id // sin FK en BD
Ref: auth.roles.organization_id > auth.organizations.id                    // sin FK en BD
Ref: auth.role_permissions.role_id > auth.roles.id                         // FK (CASCADE)
Ref: auth.role_permissions.permission_id > auth.permissions.id             // FK (CASCADE)
Ref: auth.user_roles.user_id > auth.users.id                               // FK (CASCADE)
Ref: auth.user_roles.role_id > auth.roles.id                               // FK (CASCADE)
Ref: auth.user_roles.organization_id > auth.organizations.id               // sin FK en BD
Ref: auth.user_establishments.user_id > auth.users.id                      // FK (CASCADE)
Ref: auth.pos_devices.organization_id > auth.organizations.id              // sin FK en BD
Ref: auth.device_refresh_tokens.pos_device_id > auth.pos_devices.id        // sin FK en BD

// --- organization ---
Ref: organization.establishments.organization_id > organization.organizations.id      // FK (CASCADE)
Ref: organization.emission_points.establishment_id > organization.establishments.id   // FK (CASCADE)
Ref: organization.emission_points.organization_id > organization.organizations.id     // sin FK en BD
Ref: organization.emission_points.pos_theme_id > organization.pos_themes.id           // FK (SET NULL)
Ref: organization.pos_themes.organization_id > organization.organizations.id          // FK (CASCADE)
Ref: organization.organization_countries.organization_id > organization.organizations.id // FK (CASCADE)
Ref: organization.organization_countries.country_code > organization.countries.code   // sin FK en BD

// --- tax ---
Ref: tax.tax_rates.country_code > tax.countries.code                       // FK (CASCADE)
Ref: tax.identification_types.country_code > tax.countries.code            // FK (CASCADE)
Ref: tax.document_types.country_code > tax.countries.code                  // FK (CASCADE)

// --- customer ---
Ref: customer.contacts.customer_id > customer.customers.id                 // FK (CASCADE)
Ref: customer.addresses.customer_id > customer.customers.id                // FK (CASCADE)
Ref: customer.customer_tags.customer_id > customer.customers.id            // FK (CASCADE)
Ref: customer.customer_tags.tag_id > customer.tags.id                      // FK (CASCADE)
Ref: customer.customers.identification_type_id > customer.identification_types.id // sin FK en BD

// --- product ---
Ref: product.categories.parent_id > product.categories.id                  // FK (SET NULL)
Ref: product.products.category_id > product.categories.id                  // FK (SET NULL)
Ref: product.products.unit_id > product.units.id                           // FK (SET NULL)
Ref: product.product_taxes.product_id > product.products.id                // FK (CASCADE)
Ref: product.product_images.product_id > product.products.id               // FK (CASCADE)
Ref: product.product_establishments.product_id > product.products.id       // FK (CASCADE)

// --- inventory ---
Ref: inventory.stock_layers.entry_movement_id > inventory.stock_movements.id // FK (RESTRICT)
Ref: inventory.stock_positions.warehouse_id > inventory.warehouses.id      // sin FK en BD
Ref: inventory.stock_positions.product_id > inventory.products.id          // sin FK en BD
Ref: inventory.stock_movements.warehouse_id > inventory.warehouses.id      // sin FK en BD
Ref: inventory.stock_movements.product_id > inventory.products.id          // sin FK en BD
Ref: inventory.stock_layers.warehouse_id > inventory.warehouses.id         // sin FK en BD
Ref: inventory.reservations.warehouse_id > inventory.warehouses.id         // sin FK en BD
Ref: inventory.reservations.product_id > inventory.products.id             // sin FK en BD

// --- billing (ninguna tiene FK en BD) ---
Ref: billing.invoice_lines.invoice_id > billing.invoices.id                // sin FK en BD
Ref: billing.line_taxes.invoice_line_id > billing.invoice_lines.id         // sin FK en BD
Ref: billing.invoice_tax_totals.invoice_id > billing.invoices.id           // sin FK en BD
Ref: billing.invoices.related_invoice_id > billing.invoices.id             // sin FK en BD (nota de crédito → factura)

// --- document ---
Ref: document.file_references.parent_id > document.file_references.id      // sin FK en BD

// --- plugin_catalog ---
Ref: plugin_catalog.plugins.based_on_plugin_id > plugin_catalog.plugins.id                // FK (SET NULL)
Ref: plugin_catalog.plugin_translations.plugin_id > plugin_catalog.plugins.id             // FK (CASCADE)
Ref: plugin_catalog.plugin_dependencies.plugin_id > plugin_catalog.plugins.id             // FK (CASCADE)
Ref: plugin_catalog.plugin_dependencies.depends_on_plugin_id > plugin_catalog.plugins.id  // FK (CASCADE)
Ref: plugin_catalog.organization_plugins.plugin_id > plugin_catalog.plugins.id            // FK (CASCADE)
Ref: plugin_catalog.organization_plugins.required_by_plugin_id > plugin_catalog.plugins.id // FK (SET NULL)
Ref: plugin_catalog.plugin_custom_requests.resulting_plugin_id > plugin_catalog.plugins.id // FK (SET NULL)
Ref: plugin_catalog.business_profile_plugins.business_profile_id > plugin_catalog.business_profiles.id // FK (CASCADE)
Ref: plugin_catalog.business_profile_plugins.plugin_id > plugin_catalog.plugins.id        // FK (CASCADE)
Ref: plugin_catalog.business_profile_translations.business_profile_id > plugin_catalog.business_profiles.id // FK (CASCADE)
Ref: plugin_catalog.organization_business_profiles.business_profile_id > plugin_catalog.business_profiles.id // FK (SET NULL)

// --- assistant ---
Ref: assistant.messages.conversation_id > assistant.conversations.id       // FK (CASCADE)
Ref: assistant.pending_actions.conversation_id > assistant.conversations.id // FK (CASCADE)

// ===========================================================================
//  RELACIONES LÓGICAS ENTRE SERVICIOS
//  NO son claves foráneas: son UUID que un servicio guarda de otro. Se mantienen
//  por eventos y por llamadas HTTP. Comenta este bloque para un diagrama más limpio.
// ===========================================================================

// La empresa: todas las tablas con organization_id apuntan a organization.organizations
Ref: auth.organizations.id - organization.organizations.id                 // auth guarda una copia mínima
Ref: customer.customers.organization_id > organization.organizations.id
Ref: customer.tags.organization_id > organization.organizations.id
Ref: product.categories.organization_id > organization.organizations.id
Ref: product.units.organization_id > organization.organizations.id
Ref: product.products.organization_id > organization.organizations.id
Ref: inventory.warehouses.organization_id > organization.organizations.id
Ref: inventory.products.organization_id > organization.organizations.id
Ref: billing.invoices.organization_id > organization.organizations.id
Ref: billing.sequences.organization_id > organization.organizations.id
Ref: fiscal.fiscal_invoices.organization_id > organization.organizations.id
Ref: fiscal.certificates.organization_id > organization.organizations.id
Ref: document.file_references.organization_id > organization.organizations.id
Ref: plugin_catalog.organization_plugins.organization_id > organization.organizations.id
Ref: plugin_catalog.plugin_custom_requests.organization_id > organization.organizations.id
Ref: plugin_catalog.organization_business_profiles.organization_id > organization.organizations.id
Ref: inventory.organization_plugins.organization_id > organization.organizations.id
Ref: notification.notifications.organization_id > organization.organizations.id
Ref: audit.audit_logs.organization_id > organization.organizations.id
Ref: assistant.conversations.organization_id > organization.organizations.id
Ref: assistant.usage_counters.organization_id > organization.organizations.id

// Establecimientos y puntos de emisión
Ref: auth.user_establishments.establishment_id > organization.establishments.id
Ref: auth.pos_devices.emission_point_id > organization.emission_points.id
Ref: organization.emission_points.paired_device_id - auth.pos_devices.id    // el POS emparejado
Ref: product.product_establishments.establishment_id > organization.establishments.id
Ref: inventory.warehouses.establishment_id > organization.establishments.id
Ref: billing.invoices.establishment_id > organization.establishments.id
Ref: billing.invoices.emission_point_id > organization.emission_points.id
Ref: billing.sequences.establishment_id > organization.establishments.id
Ref: billing.sequences.emission_point_id > organization.emission_points.id

// Personas (auth.users)
Ref: notification.notifications.user_id > auth.users.id
Ref: notification.notification_preferences.user_id > auth.users.id
Ref: audit.audit_logs.user_id > auth.users.id
Ref: assistant.conversations.user_id > auth.users.id
Ref: assistant.pending_actions.decided_by_user_id > auth.users.id
Ref: inventory.stock_movements.created_by > auth.users.id
Ref: plugin_catalog.organization_business_profiles.decided_by_user_id > auth.users.id

// Catálogo fiscal (tax)
Ref: billing.invoices.document_type_id > tax.document_types.id
Ref: billing.sequences.document_type_id > tax.document_types.id
Ref: billing.line_taxes.tax_rate_id > tax.tax_rates.id
Ref: product.product_taxes.tax_rate_id > tax.tax_rates.id
Ref: customer.identification_types.id - tax.identification_types.id        // copia del catálogo

// Facturación
Ref: billing.invoices.customer_id > customer.customers.id
Ref: billing.invoice_lines.product_id > product.products.id
Ref: fiscal.fiscal_invoices.billing_invoice_id - billing.invoices.id        // 1 comprobante SRI por factura/nota
Ref: inventory.products.id - product.products.id                           // copia por eventos
Ref: inventory.organization_plugins.plugin_code > plugin_catalog.plugins.code
// Un movimiento de inventario nace de un documento (polimórfico: reference_type + reference_id, p. ej. una factura de billing).

// Archivos (document-service / MinIO)
Ref: auth.users.avatar_file_id > document.file_references.id
Ref: customer.customers.image_file_id > document.file_references.id
Ref: product.product_images.file_id > document.file_references.id
Ref: fiscal.fiscal_invoices.signed_xml_file_id > document.file_references.id
Ref: fiscal.fiscal_invoices.authorized_xml_file_id > document.file_references.id
Ref: fiscal.certificates.p12_file_id > document.file_references.id
